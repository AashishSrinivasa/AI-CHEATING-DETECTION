SECRET_KEY=change-this-before-production
DEVICE=auto
FLASK_DEBUG=0
PORT=8000

# Performance tuning
LIVE_FRAME_SKIP=1
VIDEO_FRAME_SKIP=1
LIVE_MAX_WIDTH=960
LIVE_DETECT_WIDTH=640
VIDEO_MAX_WIDTH=1280
LIVE_DISPLAY_FPS=30
LIVE_WORLD_FRAME_INTERVAL=2
VIDEO_WORLD_FRAME_INTERVAL=1

# Set to 1 only when DeepSORT live re-identification is worth the extra latency.
LIVE_USE_DEEPSORT=0
